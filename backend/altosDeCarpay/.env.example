# Copie este archivo como backend/altosDeCarpay/.env y complete los valores. No lo suba a Git.
# docker-compose.yml lee aquí las credenciales tanto de PostgreSQL como del backend.

# 1. Base de datos PostgreSQL
POSTGRES_DB=altos_de_carpay_db
POSTGRES_USER=carpay_admin
POSTGRES_PASSWORD=cambie-esta-contraseña
DB_NAME=altos_de_carpay_db
DB_USER=carpay_admin
DB_PASSWORD=cambie-esta-contraseña

# 2. Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=genere-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=altosdecarpay.cl,www.altosdecarpay.cl
CORS_ALLOWED_ORIGINS=https://altosdecarpay.cl
CSRF_TRUSTED_ORIGINS=https://altosdecarpay.cl
ADMIN_URL=panel-interno-cambiar/
DJANGO_DETRAS_DE_PROXY=true
NUM_PROXIES=1
GUNICORN_WORKERS=3
CARGAR_DATOS_SEMILLA=false

# 3. Cifrado en reposo del RUT y el teléfono (obligatoria con DJANGO_DEBUG=false). Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Respáldela aparte. Para rotarla: mueva la anterior a FIELD_ENCRYPTION_KEYS_ANTERIORES y ejecute
#   docker exec carpay_backend python manage.py recifrar_datos_personales
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEYS_ANTERIORES=

# 4. Correo SMTP (si EMAIL_HOST queda vacío, los correos se muestran en la consola)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-responder@altosdecarpay.cl

# 5. Reglas de negocio
ANTICIPO_PORCENTAJE=30
PLAZO_PAGO_ANTICIPO_HORAS=24
PAGOS_SIMULADOR_PERMITIR_RECHAZO=false
