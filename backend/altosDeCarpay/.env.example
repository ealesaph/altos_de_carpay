
# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=admin/

# --- Base de datos (PostgreSQL) ---
DB_NAME=altos_de_carpay_db
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Frontend (React) autorizado a consumir la API ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Correo (en desarrollo se imprime en consola) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-responder@altosdecarpay.cl

# --- Reglas de negocio ---
ANTICIPO_PORCENTAJE=30
PLAZO_PAGO_ANTICIPO_HORAS=24
PAGOS_SIMULADOR_PERMITIR_RECHAZO=True
